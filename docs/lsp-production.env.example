# ════════════════════════════════════════════════════════════════════
#  utexo-lsp production config — SIGNET, ~30 s blocks
#  Companion to docs/LSP_PRODUCTION_ARCHITECTURE.md
#  Secrets marked ⚠ — generate with: openssl rand -hex 32
# ════════════════════════════════════════════════════════════════════

# ── Service ──────────────────────────────────────────────────────────
SERVER_ADDR="127.0.0.1:8080"                  # behind TLS reverse proxy; rate-limit
                                              # LNURL + /lightning_receive (unauthenticated by design)

# ── Database (sqlite is the only compiled-in driver → single instance) ─
DATABASE_DRIVER="sqlite"
DATABASE_URL="/var/lib/utexo-lsp/utexo_lsp.db"   # persistent volume + backups; never wipe

# ── RGB Lightning Node connection ────────────────────────────────────
LSP_BASE_URL="http://127.0.0.1:3001"          # RLN REST — private network only
RGB_NODE_BASE_URL="http://127.0.0.1:3001"
LSP_TOKEN="<rln-auth-token>"                  # ⚠ RLN runs WITH authentication in prod
RGB_NODE_TOKEN="<rln-auth-token>"             # ⚠ same token
HTTP_TIMEOUT="15s"

# ── Cron / transfers ─────────────────────────────────────────────────
CRON_EVERY="30s"
MIN_CONFIRMATIONS="3"                         # 3 confs = only ~90 s at 30 s blocks — near-free
                                              # reorg protection; LSP pays LN against on-chain
                                              # deposits at this depth
SENDRGB_FEE_RATE="1"                          # sat/vB — signet is uncongested
EXPIRY_MATCH_TOLERANCE_SEC="5"
DEFAULT_RGB_ASSIGNMENT="Any"

# ── Payment policy ───────────────────────────────────────────────────
MIN_AMT_MSAT="3000000"                        # = RLN RGB HTLC minimum; do not lower

# ── Lightning Address (LNURL-pay) ────────────────────────────────────
LIGHTNING_ADDRESS_DOMAIN_URL="https://<your-domain>"   # public https; strict validation (no path/query)
LIGHTNING_ADDRESS_SHORT_DESCRIPTION="<Your service name>"
LIGHTNING_ADDRESS_MIN_SENDABLE_MSAT="3000000"
LIGHTNING_ADDRESS_MAX_SENDABLE_MSAT="100000000"  # cap at what one channel can route

# ── APay (async payments) ────────────────────────────────────────────
APAY_BEARER_TOKEN="<openssl rand -hex 32>"    # ⚠ must equal RLN --lsp-bearer-token; fail-closed,
                                              # server-side only — NEVER ships to mobile clients
APAY_INBOUND_INVOICE_EXPIRY="3600s"           # buyer has 1h to pay the hold invoice (wall-clock)
APAY_OUTBOUND_INVOICE_EXPIRY="900s"
APAY_INBOUND_MIN_FINAL_CLTV_EXPIRY_DELTA="864"   # blocks; 864 × 30 s ≈ 7.2 h merchant-offline window.
                                              # This is near the PROTOCOL CEILING: stock LDK payers
                                              # reject routes with total CLTV > 1008 blocks, and the
                                              # LSP hop adds 72 → max usable ≈ 936. A 24 h window at
                                              # 30 s blocks requires raising payer-side
                                              # max_total_cltv_expiry_delta in SDK/RLN (code change).
                                              # (On 10-min-block networks use 144 ≈ 24 h.)
APAY_OUTBOUND_MIN_FINAL_CLTV_EXPIRY_DELTA="42"   # LDK protocol minimum (≈21 min at 30 s blocks)
APAY_CLAIM_MARGIN_BLOCKS="120"                # ≈1 h settle-safety margin at 30 s blocks
                                              # (use 12 on 10-min-block networks)

# ── Channel provisioning ─────────────────────────────────────────────
SUPPORTED_ASSET_IDS="<asset-id-1>"            # explicit allowlist, comma-separated
DEFAULT_CHANNEL_CAPACITY_SAT="100000"         # RGB channel min = 30,010 sat; 200k+ if BTC is plentiful
DEFAULT_CHANNEL_ASSET_AMOUNT="<sized-to-asset>"  # RGB inventory locked per user channel —
                                              # model: few × typical payment × expected user count
DEFAULT_CHANNEL_PUSH_MSAT="2000000"           # 2000 sat ≥ 1% LDK reserve → user deposits fully
                                              # spendable. RGB is NEVER pushed — buyers deposit
                                              # via lightning_receive (see architecture doc §4.1)

# ── Virtual channels (REQUIRED — apay mobile clients reject standard channels) ─
DEFAULT_VIRTUAL_OPEN_MODE="trusted_no_broadcast"   # global: ALL clients must be virtual-enabled
                                              # (enableVirtualChannelsV0 + virtualPeerPubkeys=[LSP])

# ── UTXO management ──────────────────────────────────────────────────
UTXO_MIN_COUNT="10"                           # colorable UTXO pool = parallelism limit for
UTXO_TARGET_COUNT="20"                        # channel opens + spreads blind receives across UTXOs
UTXO_SIZE_SAT="32000"
UTXO_FEE_RATE="1"
UTXO_SKIP_SYNC="false"

# ════════════════════════════════════════════════════════════════════
#  RLN daemon (LSP node) — for reference, not env vars:
#    rgb-lightning-node /var/lib/rln/data \
#      --daemon-listening-port 3001 \          # private network only
#      --ldk-peer-listening-port 9735 \        # the ONLY public port
#      --network signet \
#      --enable-virtual-channels-v0 \
#      --lsp-base-url "http://127.0.0.1:8080" \
#      --lsp-bearer-token "<same APAY_BEARER_TOKEN>"
#    (no --disable-authentication in production)
#
#  Bot RLN node: plain — no virtual/lsp flags (on-chain sender only).
#  Bot config alignment: ASSET_ID = SUPPORTED_ASSET_IDS; FEE_RATE 1–2
#  (sample ships 100 sat/vB — burns the budget).
# ════════════════════════════════════════════════════════════════════
