{
  "name": "my-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:open": "open ios/myapp.xcworkspace",
    "ios:pod-install": "cd ios && pod install && cd ..",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean:android": "rm -rf android/app/build android/build android/.gradle android/app/.cxx",
    "clean:ios": "rm -rf ios/build ios/DerivedData && (xcodebuild clean -workspace ios/myapp.xcworkspace -scheme myapp 2>/dev/null || true)",
    "clean:metro": "rm -rf .metro-health-check* /tmp/metro-* /tmp/haste-*",
    "clean:expo": "rm -rf .expo",
    "clean": "npm run clean:android && npm run clean:ios && npm run clean:metro"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tetherto/wdk": "^1.0.0-beta.4",
    "@utexo/rgb-sdk-rn": "file:../../rgb/rgb-sdk-rn",
    "@utexo/rgb-sdk-core": "file:../../rgb/rgb-sdk-core",
    "bare-node-runtime": "^1.1.4",
    "buffer": "^6.0.3",
    "expo": "~54.0.25",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "^6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "i": "^0.3.7",
    "npm": "^11.10.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@scure/bip39": "^2.0.1",
    "@types/node": "^24.10.2",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
